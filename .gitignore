# Python cache & build
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/

# Testing & Linting
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Datasets (Never commit raw creditcard datasets or personal data)
data/raw/*.csv
data/raw/*.zip
data/processed/*.parquet
data/processed/*.csv
!data/raw/.gitkeep
!data/processed/.gitkeep

# MLflow Experiment tracking artifacts & SQLite DB
mlruns/
mlartifacts/
*.sqlite
*.sqlite3
*.db
monitoring.db

# Model artifacts (whitelist model_metadata.json and fraud_pipeline.joblib for deployment)
artifacts/models/*.pkl
!artifacts/models/model_metadata.json
!artifacts/models/fraud_pipeline.joblib
!artifacts/models/.gitkeep

# Environment variables & secrets
.env
.env.local

# Node & Frontend
node_modules/
dist/

# IDE
.vscode/
.idea/
*.swp
